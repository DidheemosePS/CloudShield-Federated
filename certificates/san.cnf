[ req ]
default_bits       = 2048
prompt             = no
default_md         = sha256
distinguished_name = dn
req_extensions     = req_ext

[ dn ]
C  = IE
ST = Dublin
L  = Dublin
O  = LocalDev
CN = flower.local

[ req_ext ]
subjectAltName = @alt_names

[ alt_names ]
IP.1  = 127.0.0.1
DNS.1 = superlink
DNS.2 = superlink.default.svc.cluster.local
DNS.3 = localhost